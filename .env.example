# ==========================================
# CENTRAL MONOREPO ENVIRONMENT VARIABLES
# ==========================================
# This file serves as a reference for all required
# environment variables across the monorepo.
# 
# Usage: 
# Copy the relevant sections to frontend/.env and backend/.env

# ------------------------------------------
# FRONTEND VARIABLES (Copy to frontend/.env)
# ------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1
VITE_BACKEND_URL=http://localhost:8000

# ------------------------------------------
# BACKEND VARIABLES (Copy to backend/.env)
# ------------------------------------------
PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017/authsphere
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# JWT Secrets (Generate secure random strings for production)
ACCESS_TOKEN_SECRET=your_super_secret_access_token_here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_here
REFRESH_TOKEN_EXPIRY=10d

# OAuth Providers (Fill if using OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# SMTP Configuration (For emails)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
